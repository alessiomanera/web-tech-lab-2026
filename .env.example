# ==========================================
# MUSEUM TICKETING & AI GUIDE
# Environment Configuration File
# ==========================================
# Copy this file to .env, then edit .env (not this file). No quotes needed
# around any value below. Never commit your real .env; it's already in
# .gitignore.

# 1. Flask secret key: signs session cookies.
# Not required to change to run or evaluate this project: the placeholder
# below works fine locally. Only matters for a real internet-facing deployment.
FLASK_SECRET_KEY=your_super_secret_key_here

# 2. Gemini API key: powers the AI Cultural Concierge, the project's core
# feature. Get a free one at https://aistudio.google.com/app/apikey (~2 min,
# no credit card); see README.md for the full walkthrough.
# Leave it as the placeholder to run the concierge in a
# limited offline demo mode instead (no key needed, but no RAG / no AI).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# 3. Database: no configuration needed. The SQLite file is created
# automatically at instance/app.db on first run.
