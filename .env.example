# ==========================================
# MUSEUM TICKETING & AI GUIDE
# Environment Configuration File
# ==========================================

# 1. Flask Configuration
# Keep this secret key safe. It is used to sign session cookies.
# DO NOT commit the actual .env file to version control.
# Note: Double quotes are optional in .env files unless your key has spaces.
# It is generally safer to leave quotes out for API keys.
FLASK_SECRET_KEY=your_super_secret_key_here

# 2. Gemini API Configuration
# Your Google Gemini API Key used for the Cultural Concierge features.
# You can get one from Google AI Studio.
# Note: Do not use quotes around the API key.
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Database Configuration (Optional)
# If left blank, app.py defaults to 'sqlite:///app.db'
# DATABASE_URL=sqlite:///app.db
