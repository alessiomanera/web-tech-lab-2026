# Environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Database
instance/
*.db
*.sqlite3

# Distribution / packaging
dist/
build/
*.egg-info/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Project-specific private / untracked directories
# NOTE: the wildcard is root-anchored (/_*) on purpose — an unanchored _*
# also matches tests/__init__.py and would drop it from every clone.
_PERSONAL/
_CLASS_RESOURCES/
/_*

# Agent root rule files protection
/AGENTS.md
/agents.md

# Agent workspaces (kept locally, never published)
.agents/
.claude/

# Environment variables
.env
